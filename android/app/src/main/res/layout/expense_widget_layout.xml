<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="12dp">

    <!-- Header: User Name + Time Text -->
    <LinearLayout
        android:id="@+id/widget_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_user_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Quản Lý Chi Tiêu"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider - using TextView instead of View (View not allowed in RemoteViews on API 36) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155"
        android:layout_marginBottom="6dp" />

    <!-- Empty text when no transactions -->
    <TextView
        android:id="@+id/empty_tx_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Chưa có giao dịch gần đây"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:visibility="visible" />

    <!-- Item 0 -->
    <LinearLayout
        android:id="@+id/tx_item_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tx_name_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tx_amount_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F43F5E"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Item 1 -->
    <LinearLayout
        android:id="@+id/tx_item_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tx_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tx_amount_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F43F5E"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Item 2 -->
    <LinearLayout
        android:id="@+id/tx_item_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tx_name_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tx_amount_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F43F5E"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Item 3 -->
    <LinearLayout
        android:id="@+id/tx_item_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tx_name_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tx_amount_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F43F5E"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider - using TextView instead of View -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_widget_expense"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_expense"
            android:text="Chi Tiêu"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/btn_widget_income"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_income"
            android:text="Thu Nhập"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
